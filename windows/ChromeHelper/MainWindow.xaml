<Window x:Class="ChromeHelper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chrome Helper" Width="300" Height="300" MinWidth="260" MinHeight="260" Topmost="True" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
 <Border Background="#F3F0E7" CornerRadius="24" BorderBrush="#30172018" BorderThickness="1" MouseLeftButtonDown="Window_MouseLeftButtonDown"><Grid Margin="14">
  <Button Content="×" Click="Close_Click" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="3" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="#6D746C"/>
  <Grid x:Name="HomeView"><Button Click="Plus_Click" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D8FF43" BorderThickness="0" FontSize="104" FontWeight="ExtraLight" Content="+" Foreground="#172018" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="110"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-14,0,0"/></Border></ControlTemplate></Button.Template></Button></Grid>
  <Grid x:Name="SearchView" Visibility="Collapsed" Margin="8,22,8,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Which profile?" FontFamily="Georgia" FontSize="28" Foreground="#172018" Margin="0,0,0,10"/>
   <DockPanel Grid.Row="1" LastChildFill="True"><Button Content="Find" DockPanel.Dock="Right" Click="Find_Click" Background="#172018" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="SemiBold"/><TextBox x:Name="ProfileInput" KeyDown="ProfileInput_KeyDown" FontSize="15" Padding="10" BorderBrush="#172018" BorderThickness="1.5" ToolTip="e.g. naaja"/></DockPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,6"><StackPanel x:Name="ResultsPanel"/></ScrollViewer>
   <Button Grid.Row="3" Content="← Back" Click="Back_Click" Background="Transparent" BorderThickness="0" Foreground="#6D746C" HorizontalAlignment="Center" Padding="8"/>
  </Grid>
 </Grid></Border>
</Window>
